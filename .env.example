# Copy to .env and fill in. Never commit .env.

# Telegram (create a bot with @BotFather, then run `summer-hunter telegram-setup`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic (optional; without it the system is fully deterministic)
ANTHROPIC_API_KEY=

# Authorized search API for public LinkedIn discovery (optional, pick one)
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# LinkedIn job-alert emails (optional, pick one or both)
# Folder of exported .eml files:
LINKEDIN_ALERTS_DIR=
# Read-only IMAP (use an app password, never your main password):
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional overrides
# SH_TIMEZONE=Europe/Paris
# SH_NIGHT_START=00:00
# SH_NIGHT_END=06:00
# SH_DIGEST_TIME=06:00
# SH_CYCLE_INTERVAL_MINUTES=90
# SH_LLM_PROVIDER=none
# SH_LOG_LEVEL=INFO
# SH_WEB_PUBLIC_URL=https://<mac>.<tailnet>.ts.net   # stable Mini App URL (Tailscale Funnel); disables the quick tunnel
